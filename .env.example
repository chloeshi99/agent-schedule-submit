# 真实模型配置示例
# 复制为 .env 后填写。.env 不应提交到版本库。
#
# 不设置 LLM_API_KEY 时，系统一律使用离线 Mock 决策引擎（默认行为）。

# OpenAI 兼容接口地址
LLM_BASE_URL=https://api.deepseek.com/v1

# API Key —— 设置后自动启用真实模型通道
LLM_API_KEY=

# 模型名
LLM_MODEL=deepseek-chat

# 采样温度，0 表示尽可能确定
LLM_TEMPERATURE=0

# 单次运行的工具调用步数上限，达到即返回 incomplete
MAX_TOOL_CALLS=8

# 强制离线（设为 0/false/no 才会允许真实模型）
# AGENT_OFFLINE=1
